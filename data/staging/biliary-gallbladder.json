{
  "id": "biliary-gallbladder",
  "name": { "ja": "胆嚢癌", "en": "Gallbladder Cancer" },
  "edition": "biliary-gallbladder",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌（粘膜内）",
            "en": "Tis: Carcinoma in situ (intramucosal)"
          }
        },
        {
          "value": "T1a",
          "label": {
            "ja": "T1a: 粘膜固有層に浸潤",
            "en": "T1a: Invades lamina propria"
          }
        },
        {
          "value": "T1b",
          "label": {
            "ja": "T1b: 筋層に浸潤",
            "en": "T1b: Invades muscularis propria"
          }
        },
        {
          "value": "T2a",
          "label": {
            "ja": "T2a: 筋層の外へ（腹腔側）",
            "en": "T2a: Beyond the muscle layer, peritoneal side"
          }
        },
        {
          "value": "T2b",
          "label": {
            "ja": "T2b: 筋層の外へ（肝側）",
            "en": "T2b: Beyond the muscle layer, liver side"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 漿膜を破る／肝または隣接臓器1つへ直接浸潤",
            "en": "T3: Breaches serosa, or directly involves the liver or one nearby organ"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 門脈本幹・肝動脈へ浸潤／肝外2臓器以上",
            "en": "T4: Main portal vein or hepatic artery involved, or at least two organs outside the liver"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜3個",
            "en": "N1: 1–3 nodes"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上",
            "en": "N2: 4 or more nodes"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IVB" },
    { "when": {"n":["N2"]}, "stage": "IVB" },
    { "when": {"n":["N1"],"t":["T1a","T1b","T2a","T2b","T3"]}, "stage": "IIIB" },
    { "when": {"n":["N1"],"t":["T4"]}, "stage": "IVA" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1a"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T1b"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T2a"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T2b"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "IVA" }
  ]
}
