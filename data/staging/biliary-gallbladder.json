{
  "id": "biliary-gallbladder",
  "name": { "ja": "胆嚢癌", "en": "Gallbladder Cancer" },
  "edition": "biliary-gallbladder",
  "labelStatus": "legacy",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌（粘膜内）",
            "en": "Tis: Carcinoma in situ (intramucosal)"
          }
        },
        {
          "value": "T1a",
          "label": {
            "ja": "T1a: 粘膜固有層に浸潤",
            "en": "T1a: Invades lamina propria"
          }
        },
        {
          "value": "T1b",
          "label": {
            "ja": "T1b: 筋層に浸潤",
            "en": "T1b: Invades muscularis propria"
          }
        },
        {
          "value": "T2a",
          "label": {
            "ja": "T2a: 腹膜側（遊離面）の筋層外結合組織に浸潤",
            "en": "T2a: Invades perimuscular connective tissue on the peritoneal side (free surface)"
          }
        },
        {
          "value": "T2b",
          "label": {
            "ja": "T2b: 肝側（肝臓に付着している面）の筋層外結合組織に浸潤",
            "en": "T2b: Invades perimuscular connective tissue on the hepatic side (attached to liver)"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 漿膜（臓側腹膜）を穿破、および/または肝臓に直接浸潤、および/または他の隣接臓器に直接浸潤",
            "en": "T3: Perforates serosa (visceral peritoneum) and/or directly invades the liver and/or one other adjacent organ"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 主門脈または肝動脈に浸潤、または2つ以上の肝外臓器または構造に浸潤",
            "en": "T4: Invades main portal vein or hepatic artery, or two or more extrahepatic organs or structures"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1-3個の所属リンパ節転移あり",
            "en": "N1: 1-3 regional lymph node metastases"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上の所属リンパ節転移あり",
            "en": "N2: 4 or more regional lymph node metastases"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IVB" },
    { "when": {"n":["N2"]}, "stage": "IVB" },
    { "when": {"n":["N1"],"t":["T1a","T1b","T2a","T2b","T3"]}, "stage": "IIIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1a"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T1b"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T2a"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T2b"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "IVA" }
  ]
}
