{
  "id": "biliary-distal",
  "name": { "ja": "遠位胆管癌", "en": "Distal Cholangiocarcinoma" },
  "edition": "biliary-distal",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌/高度異形成",
            "en": "Tis: Carcinoma in situ/High-grade dysplasia"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 胆管壁内・浸潤の深さ5mm未満",
            "en": "T1: Bile duct wall, depth under 5 mm"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 胆管壁内・深さ5mm以上12mm未満",
            "en": "T2: Bile duct wall, depth 5 to under 12 mm"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 胆管壁内・深さ12mm以上",
            "en": "T3: Bile duct wall, depth 12 mm or more"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 主要動脈（腹腔・上腸間膜・総肝）へ浸潤",
            "en": "T4: Reaches a major artery (celiac, SMA or common hepatic)"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜3個",
            "en": "N1: 1–3 nodes"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上",
            "en": "N2: 4 or more nodes"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"t":["T4"]}, "stage": "IIIB" },
    { "when": {"n":["N2"],"t":["T1","T2","T3"]}, "stage": "IIIA" },
    { "when": {"n":["N1"],"t":["T1"]}, "stage": "IIA" },
    { "when": {"n":["N1"],"t":["T2","T3"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "I" },
    { "when": {"n":["N0"],"t":["T2"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIB" }
  ]
}
