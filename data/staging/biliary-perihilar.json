{
  "id": "biliary-perihilar",
  "edition": "biliary-perihilar",
  "labelStatus": "legacy",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌/高度異形成",
            "en": "Tis: Carcinoma in situ/High-grade dysplasia"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 胆管壁に限局する腫瘍（筋層または線維組織まで進展）",
            "en": "T1: Tumor confined to bile duct wall (invades muscularis or fibrous tissue)"
          }
        },
        {
          "value": "T2a",
          "label": {
            "ja": "T2a: 胆管壁を越えて周囲の脂肪組織に浸潤",
            "en": "T2a: Tumor invades beyond bile duct wall into periductal adipose tissue"
          }
        },
        {
          "value": "T2b",
          "label": {
            "ja": "T2b: 隣接する肝実質に浸潤",
            "en": "T2b: Tumor invades adjacent liver parenchyma"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 片側の門脈枝または肝動脈に浸潤",
            "en": "T3: Tumor invades unilateral portal vein or hepatic artery"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 主門脈またはその両側枝、あるいは片側の二次胆管枝と対側の門脈または肝動脈に浸潤",
            "en": "T4: Tumor invades main portal vein or both branches, or unilateral secondary biliary radicles with contralateral portal vein or hepatic artery invasion"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1-3個の所属リンパ節転移あり",
            "en": "N1: 1-3 regional lymph node metastases"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上の所属リンパ節転移あり",
            "en": "N2: 4 or more regional lymph node metastases"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IVB" },
    { "when": {"n":["N2"]}, "stage": "IVA" },
    { "when": {"n":["N1"]}, "stage": "IIIC" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "I" },
    { "when": {"n":["N0"],"t":["T2a","T2b"]}, "stage": "II" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "IIIB" }
  ]
}
