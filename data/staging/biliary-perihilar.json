{
  "id": "biliary-perihilar",
  "name": { "ja": "肝門部領域胆管癌", "en": "Perihilar Cholangiocarcinoma" },
  "edition": "biliary-perihilar",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌/高度異形成",
            "en": "Tis: Carcinoma in situ/High-grade dysplasia"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 胆管壁内にとどまる",
            "en": "T1: Within the bile duct wall"
          }
        },
        {
          "value": "T2a",
          "label": {
            "ja": "T2a: 壁を越え周囲の脂肪へ",
            "en": "T2a: Beyond the wall into surrounding fat"
          }
        },
        {
          "value": "T2b",
          "label": {
            "ja": "T2b: 隣接する肝実質へ",
            "en": "T2b: Into adjacent liver tissue"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 片側の門脈枝・肝動脈枝へ浸潤",
            "en": "T3: Portal vein or hepatic artery branch on one side"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 門脈本幹・両側枝へ浸潤／片側の二次胆管枝＋対側の門脈・肝動脈",
            "en": "T4: Main or both portal branches; or second-order ducts on one side plus opposite-side vessels"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜3個",
            "en": "N1: 1–3 nodes"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上",
            "en": "N2: 4 or more nodes"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IVB" },
    { "when": {"n":["N2"]}, "stage": "IVA" },
    { "when": {"n":["N1"]}, "stage": "IIIC" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "I" },
    { "when": {"n":["N0"],"t":["T2a","T2b"]}, "stage": "II" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "IIIB" }
  ]
}
