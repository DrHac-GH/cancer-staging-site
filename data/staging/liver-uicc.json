{
  "id": "liver-uicc",
  "name": { "ja": "肝癌（UICC）", "en": "Hepatocellular Carcinoma (UICC)" },
  "edition": "liver-uicc",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "T1a",
          "label": {
            "ja": "T1a: 単発2cm以下",
            "en": "T1a: Single, 2 cm or less"
          }
        },
        {
          "value": "T1b",
          "label": {
            "ja": "T1b: 単発2cm超・脈管浸潤なし",
            "en": "T1b: Single, over 2 cm, no vascular invasion"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 単発2cm超で脈管浸潤あり／多発ですべて5cm以下",
            "en": "T2: Single over 2 cm with vascular invasion, or multiple all 5 cm or less"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 多発・5cm超を含む",
            "en": "T3: Multiple, at least one over 5 cm"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 門脈・肝静脈の主枝へ浸潤／胆嚢以外の隣接臓器へ直接浸潤／臓側腹膜を破る",
            "en": "T4: Major portal or hepatic vein branch; or nearby organs other than gallbladder; or breaches visceral peritoneum"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 所属リンパ節転移あり",
            "en": "N1: Regional lymph node metastasis present"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IVB" },
    { "when": {"n":["N1"]}, "stage": "IVA" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T1a"]}, "stage": "IA" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T1b"]}, "stage": "IB" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T2"]}, "stage": "II" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T4"]}, "stage": "IIIB" }
  ]
}
