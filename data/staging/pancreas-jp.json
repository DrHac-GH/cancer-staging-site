{
  "id": "pancreas-jp",
  "name": { "ja": "膵癌（規約）", "en": "Pancreatic Cancer (Japanese Rules)" },
  "edition": "pancreas-jp",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌",
            "en": "Tis: Carcinoma in situ"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 2cm以下・膵内",
            "en": "T1: 2 cm or less, within the pancreas"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 2cm超・膵内",
            "en": "T2: Over 2 cm, within the pancreas"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 膵外へ進展（腹腔・上腸間膜の動脈には及ばない）",
            "en": "T3: Beyond the pancreas, sparing the celiac axis and SMA"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 主要動脈（腹腔・上腸間膜）に及ぶ",
            "en": "T4: Reaches the celiac axis or SMA"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 所属リンパ節転移あり",
            "en": "N1: Regional lymph node metastasis present"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"t":["T4"]}, "stage": "III" },
    { "when": {"n":["N1"],"t":["T1","T2","T3"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T2"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "III" }
  ]
}
