{
  "id": "pancreas-uicc",
  "name": { "ja": "膵癌（UICC）", "en": "Pancreatic Cancer (UICC)" },
  "edition": "pancreas-uicc",
  "labelStatus": "legacy",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌",
            "en": "Tis: Carcinoma in situ"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 腫瘍の最大径が2cm以下 (T1a: ≤0.5cm, T1b: >0.5-<1cm, T1c: 1-2cm)",
            "en": "T1: Tumor ≤ 2 cm in greatest dimension (T1a: ≤0.5cm, T1b: >0.5-<1cm, T1c: 1-2cm)"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 腫瘍の最大径が2cmを超え4cm以下",
            "en": "T2: Tumor > 2 cm and ≤ 4 cm in greatest dimension"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 腫瘍の最大径が4cmを超える",
            "en": "T3: Tumor > 4 cm in greatest dimension"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 腹腔動脈、上腸間膜動脈、総肝動脈に及ぶ腫瘍",
            "en": "T4: Tumor involves celiac axis, superior mesenteric artery, or common hepatic artery"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜3個の所属リンパ節転移あり",
            "en": "N1: 1-3 regional lymph node metastases"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上の所属リンパ節転移あり",
            "en": "N2: 4 or more regional lymph node metastases"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"n":["N2"]}, "stage": "III" },
    { "when": {"n":["N1"],"t":["T1","T2","T3"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T2"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "III" }
  ]
}
