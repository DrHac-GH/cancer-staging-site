{
  "id": "pancreas-uicc",
  "name": { "ja": "膵癌（UICC）", "en": "Pancreatic Cancer (UICC)" },
  "edition": "pancreas-uicc",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌",
            "en": "Tis: Carcinoma in situ"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 2cm以下（T1a 0.5cm以下／T1b 0.5cm超1cm未満／T1c 1〜2cm）",
            "en": "T1: 2 cm or less (T1a up to 0.5 cm / T1b over 0.5 to under 1 cm / T1c 1–2 cm)"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 2cm超4cm以下",
            "en": "T2: Over 2 cm, up to 4 cm"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 4cm超",
            "en": "T3: Over 4 cm"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 主要動脈（腹腔・上腸間膜・総肝）に及ぶ",
            "en": "T4: Reaches a major artery (celiac, SMA or common hepatic)"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜3個",
            "en": "N1: 1–3 nodes"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 4個以上",
            "en": "N2: 4 or more nodes"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"t":["T4"]}, "stage": "III" },
    { "when": {"n":["N2"]}, "stage": "III" },
    { "when": {"n":["N1"],"t":["T1","T2","T3"]}, "stage": "IIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T2"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "III" }
  ]
}
