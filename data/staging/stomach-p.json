{
  "id": "stomach-p",
  "name": {
    "ja": "胃癌",
    "en": "Gastric Cancer"
  },
  "edition": "stomach-p",
  "labelStatus": "summarized-unreviewed",
  "scope": {
    "ja": "病理分類 pStage",
    "en": "pathological stage, pStage"
  },
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 粘膜上皮内（粘膜固有層への浸潤なし）",
            "en": "Tis: Within the epithelium, no invasion of the lamina propria"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 粘膜固有層〜粘膜下層まで",
            "en": "T1: Lamina propria to submucosa"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 固有筋層まで",
            "en": "T2: Into the muscle layer"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 固有筋層を越える（漿膜表面には達しない）",
            "en": "T3: Beyond the muscle layer, not reaching the serosal surface"
          }
        },
        {
          "value": "T4a",
          "label": {
            "ja": "T4a: 漿膜表面に接する・露出",
            "en": "T4a: Touches or breaks through the serosal surface"
          }
        },
        {
          "value": "T4b",
          "label": {
            "ja": "T4b: 隣接臓器へ直接浸潤",
            "en": "T4b: Directly involves nearby organs"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 1〜2個",
            "en": "N1: 1-2 regional lymph nodes"
          }
        },
        {
          "value": "N2",
          "label": {
            "ja": "N2: 3〜6個",
            "en": "N2: 3-6 regional lymph nodes"
          }
        },
        {
          "value": "N3a",
          "label": {
            "ja": "N3a: 7〜15個",
            "en": "N3a: 7-15 regional lymph nodes"
          }
        },
        {
          "value": "N3b",
          "label": {
            "ja": "N3b: 16個以上",
            "en": "N3b: 16 or more regional lymph nodes"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"t":["Tis"],"n":["N0"]}, "stage": "0" },
    { "when": {"t":["T1"],"n":["N0"]}, "stage": "IA" },
    { "when": {"t":["T1"],"n":["N1"]}, "stage": "IB" },
    { "when": {"t":["T1"],"n":["N2"]}, "stage": "IIA" },
    { "when": {"t":["T1"],"n":["N3a"]}, "stage": "IIB" },
    { "when": {"t":["T1"],"n":["N3b"]}, "stage": "IIIB" },
    { "when": {"t":["T2"],"n":["N0"]}, "stage": "IB" },
    { "when": {"t":["T2"],"n":["N1"]}, "stage": "IIA" },
    { "when": {"t":["T2"],"n":["N2"]}, "stage": "IIB" },
    { "when": {"t":["T2"],"n":["N3a"]}, "stage": "IIIA" },
    { "when": {"t":["T2"],"n":["N3b"]}, "stage": "IIIB" },
    { "when": {"t":["T3"],"n":["N0"]}, "stage": "IIA" },
    { "when": {"t":["T3"],"n":["N1"]}, "stage": "IIB" },
    { "when": {"t":["T3"],"n":["N2"]}, "stage": "IIIA" },
    { "when": {"t":["T3"],"n":["N3a"]}, "stage": "IIIB" },
    { "when": {"t":["T3"],"n":["N3b"]}, "stage": "IIIC" },
    { "when": {"t":["T4a"],"n":["N0"]}, "stage": "IIB" },
    { "when": {"t":["T4a"],"n":["N1","N2"]}, "stage": "IIIA" },
    { "when": {"t":["T4a"],"n":["N3a"]}, "stage": "IIIB" },
    { "when": {"t":["T4a"],"n":["N3b"]}, "stage": "IIIC" },
    { "when": {"t":["T4b"],"n":["N0"]}, "stage": "IIIA" },
    { "when": {"t":["T4b"],"n":["N1","N2"]}, "stage": "IIIB" },
    { "when": {"t":["T4b"],"n":["N3a","N3b"]}, "stage": "IIIC" }
  ]
}
