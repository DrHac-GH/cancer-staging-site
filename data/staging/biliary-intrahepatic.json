{
  "id": "biliary-intrahepatic",
  "name": { "ja": "肝内胆管癌", "en": "Intrahepatic Cholangiocarcinoma" },
  "edition": "biliary-intrahepatic",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌（管内腫瘍）",
            "en": "Tis: Carcinoma in situ (intraductal tumor)"
          }
        },
        {
          "value": "T1a",
          "label": {
            "ja": "T1a: 単発5cm以下・脈管侵襲なし",
            "en": "T1a: Single, 5 cm or less, no vascular invasion"
          }
        },
        {
          "value": "T1b",
          "label": {
            "ja": "T1b: 単発5cm超・脈管侵襲なし",
            "en": "T1b: Single, over 5 cm, no vascular invasion"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 単発で肝内脈管侵襲あり／多発",
            "en": "T2: Single with intrahepatic vascular invasion, or multiple"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 臓側腹膜を破る",
            "en": "T3: Breaches the visceral peritoneum"
          }
        },
        {
          "value": "T4",
          "label": {
            "ja": "T4: 肝外の隣接構造へ直接浸潤",
            "en": "T4: Direct spread to nearby extrahepatic structures"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: 所属リンパ節転移なし",
            "en": "N0: No regional lymph node metastasis"
          }
        },
        {
          "value": "N1",
          "label": {
            "ja": "N1: 所属リンパ節転移あり",
            "en": "N1: Regional lymph node metastasis present"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: 遠隔転移なし",
            "en": "M0: No distant metastasis"
          }
        },
        {
          "value": "M1",
          "label": {
            "ja": "M1: 遠隔転移あり",
            "en": "M1: Distant metastasis present"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1"]}, "stage": "IV" },
    { "when": {"n":["N1"]}, "stage": "IIIB" },
    { "when": {"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"n":["N0"],"t":["T1a"]}, "stage": "IA" },
    { "when": {"n":["N0"],"t":["T1b"]}, "stage": "IB" },
    { "when": {"n":["N0"],"t":["T2"]}, "stage": "II" },
    { "when": {"n":["N0"],"t":["T3"]}, "stage": "IIIA" },
    { "when": {"n":["N0"],"t":["T4"]}, "stage": "IIIB" }
  ]
}
