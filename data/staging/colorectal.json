{
  "id": "colorectal",
  "name": { "ja": "大腸癌（UICC）", "en": "Colorectal Cancer (UICC)" },
  "edition": "colorectal",
  "labelStatus": "summarized-unreviewed",
  "factors": [
    {
      "key": "t",
      "label": {
        "ja": "T因子:",
        "en": "T Factor:"
      },
      "options": [
        {
          "value": "Tis",
          "label": {
            "ja": "Tis: 上皮内癌",
            "en": "Tis: Carcinoma in situ"
          }
        },
        {
          "value": "T1",
          "label": {
            "ja": "T1: 粘膜下層まで",
            "en": "T1: Invades submucosa"
          }
        },
        {
          "value": "T2",
          "label": {
            "ja": "T2: 固有筋層まで",
            "en": "T2: Invades muscularis propria"
          }
        },
        {
          "value": "T3",
          "label": {
            "ja": "T3: 固有筋層を越える（漿膜下層・周囲組織まで）",
            "en": "T3: Through the muscle layer into subserosa or surrounding tissue"
          }
        },
        {
          "value": "T4a",
          "label": {
            "ja": "T4a: 漿膜表面に露出",
            "en": "T4a: Reaches the serosal surface"
          }
        },
        {
          "value": "T4b",
          "label": {
            "ja": "T4b: 他臓器へ直接浸潤",
            "en": "T4b: Directly involves other organs"
          }
        }
      ]
    },
    {
      "key": "n",
      "label": {
        "ja": "N因子:",
        "en": "N Factor:"
      },
      "options": [
        {
          "value": "N0",
          "label": {
            "ja": "N0: なし",
            "en": "N0: None"
          }
        },
        {
          "value": "N1a",
          "label": {
            "ja": "N1a: 1個の転移",
            "en": "N1a: 1 regional lymph node metastasis"
          }
        },
        {
          "value": "N1b",
          "label": {
            "ja": "N1b: 2-3個の転移",
            "en": "N1b: 2-3 regional lymph node metastases"
          }
        },
        {
          "value": "N1c",
          "label": {
            "ja": "N1c: リンパ節転移なし・周囲組織に腫瘍結節あり",
            "en": "N1c: No nodal metastasis, but tumor deposits in surrounding tissue"
          }
        },
        {
          "value": "N2a",
          "label": {
            "ja": "N2a: 4-6個の転移",
            "en": "N2a: 4-6 regional lymph node metastases"
          }
        },
        {
          "value": "N2b",
          "label": {
            "ja": "N2b: 7個以上の転移",
            "en": "N2b: 7 or more regional lymph node metastases"
          }
        }
      ]
    },
    {
      "key": "m",
      "label": {
        "ja": "M因子:",
        "en": "M Factor:"
      },
      "options": [
        {
          "value": "M0",
          "label": {
            "ja": "M0: なし",
            "en": "M0: None"
          }
        },
        {
          "value": "M1a",
          "label": {
            "ja": "M1a: 遠隔転移1臓器（腹膜転移なし）",
            "en": "M1a: One organ, no peritoneal spread"
          }
        },
        {
          "value": "M1b",
          "label": {
            "ja": "M1b: 遠隔転移2臓器以上",
            "en": "M1b: Two or more organs"
          }
        },
        {
          "value": "M1c",
          "label": {
            "ja": "M1c: 腹膜転移あり（他臓器は問わない）",
            "en": "M1c: Peritoneal spread, with or without other organs"
          }
        }
      ]
    }
  ],
  "rules": [
    { "when": {"m":["M1c"]}, "stage": "IVC" },
    { "when": {"m":["M1b"]}, "stage": "IVB" },
    { "when": {"m":["M1a"]}, "stage": "IVA" },
    { "when": {"m":["M0"],"n":["N0"],"t":["Tis"]}, "stage": "0" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T1","T2"]}, "stage": "I" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T3"]}, "stage": "IIA" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T4a"]}, "stage": "IIB" },
    { "when": {"m":["M0"],"n":["N0"],"t":["T4b"]}, "stage": "IIC" },
    { "when": {"m":["M0"],"n":["N1a","N1b","N1c"],"t":["T1","T2"]}, "stage": "IIIA" },
    { "when": {"m":["M0"],"n":["N1a","N1b","N1c"],"t":["T3","T4a"]}, "stage": "IIIB" },
    { "when": {"m":["M0"],"n":["N2a"],"t":["T1"]}, "stage": "IIIA" },
    { "when": {"m":["M0"],"n":["N2a"],"t":["T2","T3"]}, "stage": "IIIB" },
    { "when": {"m":["M0"],"n":["N2a"],"t":["T4a"]}, "stage": "IIIC" },
    { "when": {"m":["M0"],"n":["N2b"],"t":["T1","T2"]}, "stage": "IIIB" },
    { "when": {"m":["M0"],"n":["N2b"],"t":["T3","T4a"]}, "stage": "IIIC" },
    { "when": {"m":["M0"],"n":["N1a","N1b","N1c","N2a","N2b"],"t":["T4b"]}, "stage": "IIIC" }
  ]
}
